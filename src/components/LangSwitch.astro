---
import { pathFor, otherLang } from '../i18n/routes.ts';
import type { Lang, PageKey } from '../i18n/routes.ts';
import { t } from '../i18n/t.ts';
interface Props { lang: Lang; page: PageKey }
const { lang, page } = Astro.props;
const other = otherLang(lang);
---
<a class="lang-switch" href={pathFor(page, other)} hreflang={other} lang={other} data-lang-switch>{t(other, 'switch.label')}</a>
