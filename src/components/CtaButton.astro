---
import type { Lang } from '../i18n/routes.ts';
import { site } from '../config/site.ts';
import { t } from '../i18n/t.ts';
import LaunchLabel from './LaunchLabel.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<div class="cta-row">
  <a href={site.appUrl} class="cta">{t(lang, 'cta.try')}</a>
  {site.showLaunchLabel && <LaunchLabel lang={lang} />}
</div>
