---
import { pageKeys, pathFor } from '../i18n/routes.ts';
import type { Lang, PageKey } from '../i18n/routes.ts';
import { t } from '../i18n/t.ts';
import LangSwitch from './LangSwitch.astro';
interface Props { lang: Lang; page: PageKey }
const { lang, page } = Astro.props;
const navKeys = pageKeys.filter((k) => k !== 'home');
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href={pathFor('home', lang)} aria-label={t(lang, 'aria.home')}>{t(lang, 'brand')}</a>
    <nav aria-label={t(lang, 'aria.mainNav')}>
      <ul class="nav-list">
        {navKeys.map((k) => (
          <li><a href={pathFor(k, lang)} aria-current={k === page ? 'page' : undefined}>{t(lang, `nav.${k}`)}</a></li>
        ))}
        <li><LangSwitch lang={lang} page={page} /></li>
      </ul>
    </nav>
  </div>
</header>
